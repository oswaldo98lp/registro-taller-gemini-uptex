# ============================================================================
# CONFIGURACIÓN GENERAL DEL SERVIDOR
# ============================================================================
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=registro-taller.up.railway.app

# Clave secreta para disparar el cron manualmente o vía cron-job.org en hosting gratuito
CRON_SECRET=gsa_2026_uptex_cron_secret_key

# ============================================================================
# DATOS EDITABLES DEL TALLER (Opcional: sobrescriben config/workshop.config.js)
# ============================================================================
WORKSHOP_TITLE="Sesión Google Gemini Multidisciplinaria"
WORKSHOP_SPEAKER="Oswaldo Lucas Pablo"
WORKSHOP_UNIVERSITY="Universidad Politécnica de Texcoco (UPTEX)"
WORKSHOP_LOCATION="Laboratorio 3"
WORKSHOP_DATE="2026-11-10"
WORKSHOP_CAPACITY_PER_SESSION=40
WORKSHOP_TIMEZONE="America/Mexico_City"

# ============================================================================
# GOOGLE SHEETS API (Service Account)
# ============================================================================
# Puedes pegar el ID directamente o el enlace completo de Google Sheets:
GOOGLE_SHEET_ID=1kDYJ43MRqrcp9GE6-iLXxDW9eGN6UNAVnX5LbpUe5JU
GOOGLE_SHEET_TAB_NAME=Registros

# OPCIÓN A (Recomendada en servidor/nube): Correo y Llave Privada de la Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_LLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# OPCIÓN B (Opcional en local): Ruta al archivo JSON descargado de Google Cloud
# Si colocas tu archivo como ./service-account.json en la raíz, se detectará automáticamente.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ============================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (Proveedor: "smtp" o "resend")
# ============================================================================
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME="Estudiantes Embajadores de Google - UPTEX"
EMAIL_FROM_ADDRESS=tu-correo@gmail.com

# --- Si EMAIL_PROVIDER=smtp (Gmail con Contraseña de Aplicación de 16 letras) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# --- Si EMAIL_PROVIDER=resend (API de Resend.com) ---
RESEND_API_KEY=re_123456789_tu_api_key
